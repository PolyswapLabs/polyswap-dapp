# Deny by default. Only files explicitly required to build the listener image
# enter the Docker build context, so .env files and frontend sources cannot be
# captured in an image layer accidentally.
**

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!sentry.server.config.ts

!prisma/
!prisma/schema.prisma

!src/
!src/abi/
!src/abi/**
!src/backend/
!src/backend/**
!src/lib/
!src/lib/env.ts
!src/lib/polymarket/
!src/lib/polymarket/**
!src/lib/marketRecommendations.ts
!src/lib/rpc/
!src/lib/rpc/**
!src/types/
!src/types/design.ts

# Keep secret files excluded even if one is accidentally created below an
# otherwise allowed source directory.
.env
.env.*
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
